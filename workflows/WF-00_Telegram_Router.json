      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json||{});\nconst u=$('Telegram Trigger').first().json||{};\nconst tgId=String(u.callback_query?.from?.id ?? u.message?.from?.id ?? '');\nconst user=rows.find(r=>String(r.telegram_id||'')===tgId);\nif(!user || String(user.status||'').toLowerCase()!=='active'){\n  return [{json:{authorized:false,reply:'⛔ غير مصرح لك باستخدام OpsMind AI أو أن حسابك غير مسجل في الشركة أو غير نشط.',chat_id:String(u.callback_query?.message?.chat?.id ?? u.message?.chat?.id ?? tgId)}}];\n}\nreturn [{json:{authorized:true,user_id:String(user.user_id||''),user_name:String(user.name||''),role:String(user.role||''),status:String(user.status||''),telegram_id:tgId,chat_id:String(u.callback_query?.message?.chat?.id ?? u.message?.chat?.id ?? tgId)}}];"
      },
