    {
      "parameters": {
        "jsCode": "let raw = $json.output ?? $json.text ?? '';\nraw = String(raw).replace(/^```json\\s*/, '').replace(/```$/, '').trim();\n\nlet d;\ntry {\n  d = JSON.parse(raw);\n} catch (e) {\n  d = { intent: 'unknown', action: 'unknown', reply: 'الرسالة غير واضحة، يرجى تحديد طلبك.' };\n}\n\nconst base = $('Prepare Request').first().json || {};\nconst role = base.role;\n\nconst allowed = {\n  invoice: ['Manager', 'Admin', 'Employee'],\n  customer: ['Manager', 'Admin', 'Employee'],\n  order: ['Manager', 'Admin', 'Employee'],\n  ticket: ['Manager', 'Admin', 'Employee'],\n  product: ['Manager', 'Admin', 'Employee'],\n  report: ['Manager', 'Admin'],\n  approval: ['Manager', 'Admin']\n};\n\nconst actions = ['view', 'add', 'update', 'delete', 'approve', 'reject', 'process', 'unknown'];\n\nif (d.intent === 'unknown' || !allowed[d.intent]) {\n  // الـ AI لم يفهم الطلب أو رفضه: نحتفظ برده\n  d.intent = 'unknown';\n  d.action = 'unknown';\n  d.reply = d.reply || 'الرسالة غير واضحة، يرجى تحديد طلبك.';\n} else if (!allowed[d.intent].includes(role)) {\n  // نية معروفة لكن دور المستخدم لا يسمح\n  d.intent = 'unknown';\n  d.action = 'unknown';\n  d.reply = 'ليس لديك صلاحية لتنفيذ هذا الطلب.';\n}\n\nif (!actions.includes(d.action)) d.action = 'unknown';\n\nconst safeData = (d.data && typeof d.data === 'object') ? d.data : {};\n\nreturn [{\n  json: {\n    ...base,\n    ...safeData,\n    // حماية الهوية: لا يستطيع الـ AI تغيير هذه الحقول\n    user_id: base.user_id,\n    user_name: base.user_name,\n    role: base.role,\n    chat_id: base.chat_id,\n    telegram_id: base.telegram_id,\n    intent: d.intent || 'unknown',\n    action: d.action || 'unknown',\n    reply: d.reply || '',\n    data: safeData\n  }\n}];"
      },
