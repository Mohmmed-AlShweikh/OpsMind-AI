        "jsCode": "const u=$('Telegram Trigger').first().json||{}; const base=$json||{}; const cb=u.callback_query;\nif(cb){const parts=String(cb.data||'').split('|'); const action=parts[0]==='approve'?'approve':parts[0]==='reject'?'reject':'unknown'; return [{json:{...base,request:'',intent:'approval',action,approval_id:parts[1]||'',callback_query_id:String(cb.id||''),callback_user_id:String(cb.from?.id||''),is_callback:true,is_start:false,chat_id:String(cb.message?.chat?.id||base.chat_id||'')}}];}\nconst request=String(u.message?.text||'').trim(); return [{json:{...base,request,is_callback:false,is_start:/^(\\/start|start)$/i.test(request),callback_user_id:'',chat_id:String(u.message?.chat?.id||base.chat_id||'')}}];"
