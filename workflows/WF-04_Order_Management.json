      "parameters": {
        "jsCode": "\nconst d = $json || {};\n\nconst requiredFields = [\n  'customer_id',\n  'product_id',\n  'quantity',\n  'total_amount'\n];\n\nconst missing = requiredFields.filter(key =>\n  d[key] === undefined ||\n  d[key] === null ||\n  String(d[key]).trim() === ''\n);\n\nif (missing.length > 0) {\n  return [{\n    json: {\n      ...d,\n      missing_fields: true,\n      missing_field_names: missing,\n      reply: `⚠️ لا يمكن إضافة الطلب. البيانات الناقصة: ${missing.join('، ')}`,\n      result_type: 'order_add',\n      audit_action: 'add',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...d,\n    missing_fields: false,\n    status: String(d.status || 'Pending')\n  }\n}];"
