      "parameters": {
        "jsCode": "\nconst input = $json || {};\n\n// ---------- Helpers ----------\nconst clean = (value) => {\n  if (value === undefined || value === null) return undefined;\n  const result = String(value).trim();\n  return result || undefined;\n};\n\nconst normalizeId = (value) => {\n  const result = clean(value);\n  return result ? result.toUpperCase() : undefined;\n};\n\n// ---------- Read request ----------\nlet request = input.request ?? '';\nlet parsedRequest = {};\n\nif (typeof request === 'object' && request !== null) {\n  parsedRequest = request;\n  request = '';\n} else {\n  request = String(request);\n\n  try {\n    const parsed = JSON.parse(request);\n    if (parsed && typeof parsed === 'object') {\n      parsedRequest = parsed;\n    }\n  } catch {}\n}\n\n// ---------- Read AI data ----------\nlet aiData = input.data ?? {};\n\nif (typeof aiData === 'string') {\n  try {\n    aiData = JSON.parse(aiData);\n  } catch {\n    aiData = {};\n  }\n}\n\nif (!aiData || typeof aiData !== 'object' || Array.isArray(aiData)) {\n  aiData = {};\n}\n\nconst source = {\n  ...input,\n  ...parsedRequest,\n  ...aiData,\n};\n\nconst text = String(request).trim();\n\nconst get = (...keys) => {\n  for (const key of keys) {\n    const value = source[key];\n    if (\n      value !== undefined &&\n      value !== null &&\n      String(value).trim() !== ''\n    ) {\n      return value;\n    }\n  }\n  return undefined;\n};\n\n// ---------- Extract labeled fields ----------\nfunction labeledValue(labels) {\n  const label = labels.join('|');\n\n  const re = new RegExp(\n    '(?:^|\\\\n|[,;|])\\\\s*(?:' + label +\n    ')\\\\s*[:=：-]\\\\s*([^\\\\n,;|]+)',\n    'i'\n  );\n\n  return text.match(re)?.[1]?.trim();\n}\n\n// ---------- Determine action ----------\nlet action = String(source.action || '').trim().toLowerCase();\n\nconst actionAliases = {\n  'عرض': 'view',\n  'اعرض': 'view',\n  'ورجيني': 'view',\n  'شوف': 'view',\n  'إضافة': 'add',\n  'اضافة': 'add',\n  'أضف': 'add',\n  'اضف': 'add',\n  'ضيف': 'add',\n  'أنشئ': 'add',\n  'انشئ': 'add',\n  'تعديل': 'update',\n  'عدل': 'update',\n  'عدّل': 'update',\n  'حدث': 'update',\n  'حدّث': 'update',\n  'غيّر': 'update',\n  'غير': 'update',\n  'زبط': 'update',\n  'ظبط': 'update',\n  'حذف': 'delete',\n  'احذف': 'delete',\n  'امسح': 'delete',\n  'شيل': 'delete',\n};\n\nif (actionAliases[action]) {\n  action = actionAliases[action];\n}\n\nif (!['view', 'add', 'update', 'delete'].includes(action)) {\n  if (/\\b(add|create)\\b|إضافة|اضافة|أضف|اضف|ضيف|أنشئ|انشئ/i.test(text)) {\n    action = 'add';\n  } else if (/\\b(update|edit|change|modify)\\b|تعديل|عدّل|عدل|حدّث|حدث|غيّر|غير|زبط|ظبط/i.test(text)) {\n    action = 'update';\n  } else if (/\\b(delete|remove|cancel)\\b|احذف|حذف|امسح|مسح|شيل|الغِ|إلغاء|الغاء/i.test(text)) {\n    action = 'delete';\n  } else {\n    action = 'view';\n  }\n}\n\n// ---------- Extract IDs ----------\nlet order_id = get('order_id', 'orderId', 'orderID');\nlet customer_id = get('customer_id', 'customerId', 'customerID');\nlet product_id = get('product_id', 'productId', 'productID');\n\norder_id = order_id || labeledValue([\n  'order\\\\s*(?:id|number|no\\\\.?|#)',\n  'رقم\\\\s*الطلب',\n  'معرّف\\\\s*الطلب',\n  'معرف\\\\s*الطلب'\n]);\n\ncustomer_id = customer_id || labeledValue([\n  'customer\\\\s*(?:id|number|no\\\\.?|#)',\n  'رقم\\\\s*العميل',\n  'معرّف\\\\s*العميل',\n  'معرف\\\\s*العميل'\n]);\n\nproduct_id = product_id || labeledValue([\n  'product\\\\s*(?:id|number|no\\\\.?|#)',\n  'رقم\\\\s*المنتج',\n  'معرّف\\\\s*المنتج',\n  'معرف\\\\s*المنتج'\n]);\n\nif (!order_id) {\n  order_id = text.match(/\\b(?:order\\s*)?(O\\d+)\\b/i)?.[1];\n}\n\nif (!customer_id) {\n  customer_id = text.match(/\\b(?:customer\\s*)?(C\\d+)\\b/i)?.[1];\n}\n\nif (!product_id) {\n  product_id = text.match(/\\b(?:product\\s*)?(P\\d+)\\b/i)?.[1];\n}\n\n// ---------- Extract order fields ----------\nlet quantity = get('quantity', 'qty', 'count');\nlet total_amount = get(\n  'total_amount',\n  'totalAmount',\n  'amount',\n  'total'\n);\nlet status = get('status');\n\nquantity = quantity ?? labeledValue([\n  'quantity',\n  'qty',\n  'order\\\\s*quantity',\n  'الكمية',\n  'كمية'\n]);\n\ntotal_amount = total_amount ?? labeledValue([\n  'total\\\\s*amount',\n  'total',\n  'amount',\n  'الإجمالي',\n  'الاجمالي',\n  'المبلغ\\\\s*الإجمالي',\n  'المبلغ',\n  'قيمة\\\\s*الطلب'\n]);\n\nstatus = status || labeledValue([\n  'status',\n  'order\\\\s*status',\n  'الحالة',\n  'حالة\\\\s*الطلب',\n  'حالة'\n]);\n\n// ---------- Natural-language update extraction ----------\nif (action === 'update') {\n  const idMatch = text.match(\n    /(?:order\\s*(?:id|number|no\\.?)?|الطلب\\s*(?:رقم\\s*)?|رقم\\s*الطلب)\\s*[:=#-]?\\s*(O\\d+|[A-Z]+\\d+|\\d+)/i\n  );\n\n  order_id = order_id || idMatch?.[1];\n\n  quantity = quantity ?? text.match(\n    /(?:quantity|qty|الكمية|كمية)\\s*[:=]?\\s*(\\d+(?:\\.\\d+)?)/i\n  )?.[1];\n\n  total_amount = total_amount ?? text.match(\n    /(?:total\\s*amount|amount|total|المبلغ|الإجمالي|الاجمالي|قيمة\\s*الطلب)\\s*[:=]?\\s*(\\d+(?:\\.\\d+)?)/i\n  )?.[1];\n\n  status = status || text.match(\n    /(?:حالة\\s*الطلب|الحالة|status)\\s*[:=]?\\s*([^,\\n;|]+)/i\n  )?.[1]?.trim();\n}\n\n// ---------- Normalize numeric fields ----------\nconst normalizeNumber = (value) => {\n  if (value === undefined || value === null || String(value).trim() === '') {\n    return undefined;\n  }\n\n  const number = Number(String(value).replace(/,/g, '').trim());\n  return Number.isFinite(number) ? number : value;\n};\n\n// ---------- Output ----------\nreturn [{\n  json: {\n    ...input,\n    action,\n    order_id: normalizeId(order_id),\n    customer_id: normalizeId(customer_id),\n    product_id: normalizeId(product_id),\n    quantity: normalizeNumber(quantity),\n    total_amount: normalizeNumber(total_amount),\n    status: clean(status),\n  }\n}];"
      },
