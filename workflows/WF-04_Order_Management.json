      "parameters": {
        "jsCode": "const rows = $input.all().map(x => x.json);\n\nconst lines = rows\n  .map(r =>\n    Object.entries(r)\n      .filter(([k]) => k !== 'row_number')\n      .map(([k, v]) => `${k}: ${v}`)\n      .join(' | ')\n  )\n  .join('\\n');\n\nconst original = $('Prepare Order Action').first().json;\n\n// IDs of all displayed orders\nconst entityIds = rows\n  .map(r => String(r.order_id || '').trim())\n  .filter(Boolean)\n  .join(', ');\n\nreturn [{\n  json: {\n    ...original,\n    reply: rows.length\n      ? `📋 الطلبات:\\n${lines}`\n      : 'لا توجد بيانات في الطلبات.',\n    result_type: 'order_view',\n    audit_action: 'view',\n    audit_status: 'success',\n    entity_id: entityIds\n  }\n}];"
