    {
      "parameters": {
        "jsCode": "\nconst input = $('Prepare Order Action').first()?.json || {};\nconst rows = $input.all().map(item => item.json || {});\n\nconst normalizeId = value =>\n  String(value ?? '').trim().toUpperCase();\n\nconst hasValue = value =>\n  value !== undefined &&\n  value !== null &&\n  String(value).trim() !== '';\n\nconst targetId = normalizeId(input.order_id || input.id);\n\nif (!targetId) {\n  return [{\n    json: {\n      ...input,\n      not_found: true,\n      missing_update_fields: false,\n      reply: '⚠️ أرسل رقم الطلب الذي تريد تعديله، مثل O003.',\n      result_type: 'order_update',\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nconst found = rows.find(row =>\n  normalizeId(row.order_id || row.id) === targetId\n);\n\nif (!found) {\n  return [{\n    json: {\n      ...input,\n      order_id: targetId,\n      not_found: true,\n      missing_update_fields: false,\n      reply: `⚠️ الطلب ${targetId} غير موجود، ولم يتم إجراء أي تعديل.`,\n      result_type: 'order_update',\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nconst fields = [\n  'customer_id',\n  'product_id',\n  'quantity',\n  'total_amount',\n  'status'\n];\n\nconst changed = fields.filter(key => hasValue(input[key]));\n\nif (!changed.length) {\n  return [{\n    json: {\n      ...input,\n      ...found,\n      order_id: found.order_id || targetId,\n      not_found: false,\n      missing_update_fields: true,\n      reply: '⚠️ الطلب موجود، لكن لم تحدد ما الذي تريد تعديله. مثال: غيّر حالة الطلب O003 إلى Approved.',\n      result_type: 'order_update',\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\n// Preserve old values and replace only explicitly supplied fields.\nconst updateData = {\n  ...found,\n  ...input,\n  order_id: found.order_id || targetId,\n  not_found: false,\n  missing_update_fields: false\n};\n\nfor (const key of fields) {\n  updateData[key] = hasValue(input[key])\n    ? input[key]\n    : found[key];\n}\n\nreturn [{ json: updateData }];"
      },
