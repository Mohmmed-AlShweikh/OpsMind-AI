    {
      "parameters": {
        "jsCode": "\nconst d = $json || {};\n\nconst mode = String(d.ticket_mode || 'manual').trim().toLowerCase();\nconst isComplaint = mode === 'complaint';\n\n// الحقول الإلزامية تختلف حسب نوع الطلب:\n// manual: جميع الحقول الثلاثة إلزامية.\n// complaint: الموضوع والوصف إلزاميان، ومعرّف العميل غير إلزامي.\nconst requiredFields = isComplaint\n  ? ['subject', 'description']\n  : ['customer_id', 'subject', 'description'];\n\nconst missing = requiredFields.filter((key) =>\n  d[key] === undefined ||\n  d[key] === null ||\n  String(d[key]).trim() === ''\n);\n\nif (missing.length > 0) {\n  const fieldNames = {\n    customer_id: 'رقم العميل (customer_id)',\n    subject: 'موضوع التذكرة (subject)',\n    description: 'وصف المشكلة (description)',\n  };\n\n  const missingNames = missing.map((key) => fieldNames[key] || key);\n\n  return [{\n    json: {\n      ...d,\n      add_valid: false,\n      reply: `⚠️ لا يمكن إضافة التذكرة. يرجى تزويدي بالبيانات الناقصة: ${missingNames.join('، ')}`,\n      result_type: 'ticket_add',\n      audit_action: 'add',\n      audit_status: 'failed',\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...d,\n    ticket_mode: isComplaint ? 'complaint' : 'manual',\n    add_valid: true,\n    status: String(d.status || 'Open').trim(),\n  }\n}];"
      },
