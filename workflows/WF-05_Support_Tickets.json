      "parameters": {
        "jsCode": "\nconst input = $json || {};\n\n// ---------- Helpers ----------\nconst clean = (value) => {\n  if (value === undefined || value === null) return undefined;\n  const result = String(value).trim();\n  return result || undefined;\n};\n\nconst normalizeId = (value) => {\n  const result = clean(value);\n  return result ? result.toUpperCase() : undefined;\n};\n\n// ---------- Read request and AI data ----------\nlet request = input.request ?? '';\nlet parsedRequest = {};\n\nif (typeof request === 'object' && request !== null) {\n  parsedRequest = request;\n  request = '';\n} else {\n  request = String(request);\n\n  try {\n    const parsed = JSON.parse(request);\n    if (parsed && typeof parsed === 'object') {\n      parsedRequest = parsed;\n    }\n  } catch {}\n}\n\nlet aiData = input.data ?? {};\n\nif (typeof aiData === 'string') {\n  try {\n    aiData = JSON.parse(aiData);\n  } catch {\n    aiData = {};\n  }\n}\n\nif (!aiData || typeof aiData !== 'object' || Array.isArray(aiData)) {\n  aiData = {};\n}\n\nconst source = {\n  ...input,\n  ...parsedRequest,\n  ...aiData,\n};\n\nconst text = String(request).trim();\n\nconst get = (...keys) => {\n  for (const key of keys) {\n    const value = source[key];\n    if (value !== undefined && value !== null &&\n        String(value).trim() !== '') {\n      return value;\n    }\n  }\n  return undefined;\n};\n\n// ---------- Extract labeled fields ----------\nfunction labeledValue(labels) {\n  const label = labels.join('|');\n\n  const re = new RegExp(\n    '(?:^|\\\\n|[,;|])\\\\s*(?:' + label +\n    ')\\\\s*[:=：-]\\\\s*([^\\\\n,;|]+)',\n    'i'\n  );\n\n  return text.match(re)?.[1]?.trim();\n}\n\n// ---------- Determine action ----------\nlet action = String(source.action || '').trim().toLowerCase();\n\nconst actionAliases = {\n  'عرض': 'view',\n  'اعرض': 'view',\n  'ورجيني': 'view',\n  'شوف': 'view',\n  'إضافة': 'add',\n  'اضافة': 'add',\n  'أضف': 'add',\n  'اضف': 'add',\n  'ضيف': 'add',\n  'أنشئ': 'add',\n  'انشئ': 'add',\n  'افتح': 'add',\n  'تعديل': 'update',\n  'عدل': 'update',\n  'عدّل': 'update',\n  'حدث': 'update',\n  'حدّث': 'update',\n  'غيّر': 'update',\n  'غير': 'update',\n  'زبط': 'update',\n  'ظبط': 'update',\n  'حذف': 'delete',\n  'احذف': 'delete',\n  'امسح': 'delete',\n  'شيل': 'delete',\n};\n\nif (actionAliases[action]) {\n  action = actionAliases[action];\n}\n\nif (!['view', 'add', 'update', 'delete'].includes(action)) {\n  if (/\\b(add|create|open)\\b|إضافة|اضافة|أضف|اضف|ضيف|أنشئ|انشئ|افتح|إنشاء|انشاء/i.test(text)) {\n    action = 'add';\n  } else if (/\\b(update|edit|change|modify)\\b|تعديل|عدّل|عدل|حدّث|حدث|غيّر|غير|زبط|ظبط/i.test(text)) {\n    action = 'update';\n  } else if (/\\b(delete|remove)\\b|احذف|حذف|امسح|مسح|شيل/i.test(text)) {\n    action = 'delete';\n  } else {\n    action = 'view';\n  }\n}\n\n// ---------- Extract ticket and customer IDs ----------\nlet ticket_id = get(\n  'ticket_id', 'ticketId', 'ticketID'\n);\n\nlet customer_id = get(\n  'customer_id', 'customerId', 'customerID'\n);\n\nticket_id = ticket_id || labeledValue([\n  'ticket\\\\s*(?:id|number|no\\\\.?|#)',\n  'رقم\\\\s*التذكرة',\n  'معرّف\\\\s*التذكرة',\n  'معرف\\\\s*التذكرة'\n]);\n\ncustomer_id = customer_id || labeledValue([\n  'customer\\\\s*(?:id|number|no\\\\.?|#)',\n  'رقم\\\\s*العميل',\n  'معرّف\\\\s*العميل',\n  'معرف\\\\s*العميل'\n]);\n\nif (!ticket_id) {\n  ticket_id = text.match(\n    /\\b(?:ticket\\s*)?(T\\d+)\\b/i\n  )?.[1];\n}\n\nif (!customer_id) {\n  customer_id = text.match(\n    /\\b(?:customer\\s*)?(C\\d+)\\b/i\n  )?.[1];\n}\n\n// ---------- Extract ticket fields ----------\nlet subject = get(\n  'subject', 'title', 'ticket_title', 'ticketTitle'\n);\n\nlet description = get(\n  'description', 'details', 'message', 'ticket_description'\n);\n\nlet status = get('status');\n\nsubject = subject || labeledValue([\n  'subject',\n  'ticket\\\\s*title',\n  'title',\n  'موضوع\\\\s*التذكرة',\n  'موضوع',\n  'عنوان\\\\s*التذكرة',\n  'العنوان'\n]);\n\ndescription = description || labeledValue([\n  'description',\n  'details',\n  'ticket\\\\s*description',\n  'وصف\\\\s*التذكرة',\n  'الوصف',\n  'وصف',\n  'التفاصيل',\n  'تفاصيل'\n]);\n\nstatus = status || labeledValue([\n  'status',\n  'ticket\\\\s*status',\n  'الحالة',\n  'حالة\\\\s*التذكرة',\n  'حالة'\n]);\n\n// ---------- Natural-language update extraction ----------\nif (action === 'update') {\n  const idMatch = text.match(\n    /(?:ticket\\s*(?:id|number|no\\.?)?|التذكرة\\s*(?:رقم\\s*)?|رقم\\s*التذكرة)\\s*[:=#-]?\\s*(T\\d+|[A-Z]+\\d+|\\d+)/i\n  );\n\n  ticket_id = ticket_id || idMatch?.[1];\n\n  subject = subject || text.match(\n    /(?:موضوعها|موضوعه|موضوع التذكرة|العنوان|subject|title)\\s*[:=]?\\s*([^,\\n;|]+)/i\n  )?.[1]?.trim();\n\n  description = description || text.match(\n    /(?:وصفها|وصفه|الوصف|التفاصيل|تفاصيل|description|details)\\s*[:=]?\\s*([^,\\n;|]+)/i\n  )?.[1]?.trim();\n\n  status = status || text.match(\n    /(?:حالتها|حالته|حالة التذكرة|الحالة|status)\\s*[:=]?\\s*([^,\\n;|]+)/i\n  )?.[1]?.trim();\n}\n\n// ---------- Output ----------\nreturn [{\n  json: {\n    ...input,\n    action,\n    ticket_id: normalizeId(ticket_id),\n    customer_id: normalizeId(customer_id),\n    subject: clean(subject),\n    description: clean(description),\n    status: clean(status),\n  }\n}];"
      },
