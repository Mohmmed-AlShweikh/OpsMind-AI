    {
      "parameters": {
        "jsCode": "\nconst input = $('Prepare Ticket Action').first()?.json || {};\nconst rows = $input.all().map(item => item.json || {});\n\nconst normalizeId = value =>\n  String(value ?? '').trim().toUpperCase();\n\nconst hasValue = value =>\n  value !== undefined &&\n  value !== null &&\n  String(value).trim() !== '';\n\nconst ticketId = normalizeId(input.ticket_id);\n\nif (!ticketId) {\n  return [{\n    json: {\n      ...input,\n      not_found: true,\n      missing_update_fields: false,\n      reply: '⚠️ أرسل رقم التذكرة التي تريد تعديلها، مثل T003.',\n      result_type: 'ticket_update',\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nconst found = rows.find(row =>\n  normalizeId(row.ticket_id || row.id) === ticketId\n);\n\nif (!found) {\n  return [{\n    json: {\n      ...input,\n      ticket_id: ticketId,\n      not_found: true,\n      missing_update_fields: false,\n      reply: `⚠️ التذكرة ${ticketId} غير موجودة، ولم يتم إجراء أي تعديل.`,\n      result_type: 'ticket_update',\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nconst fields = [\n  'customer_id',\n  'subject',\n  'description',\n  'status'\n];\n\nconst changed = fields.filter(key => hasValue(input[key]));\n\nif (!changed.length) {\n  return [{\n    json: {\n      ...found,\n      ...input,\n      ticket_id: found.ticket_id || ticketId,\n      not_found: false,\n      missing_update_fields: true,\n      reply: '⚠️ التذكرة موجودة، لكن لم تحدد ما الذي تريد تعديله.',\n      result_type: 'ticket_update',\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nconst updateData = {\n  ...found,\n  ...input,\n  ticket_id: found.ticket_id || ticketId,\n  not_found: false,\n  missing_update_fields: false\n};\n\nfor (const key of fields) {\n  updateData[key] = hasValue(input[key])\n    ? input[key]\n    : found[key];\n}\n\nreturn [{ json: updateData }];"
      },
