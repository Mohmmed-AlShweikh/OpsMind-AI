    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(x => x.json || {});\nconst prep = $('Prepare Invoice Request').first().json || {};\n\nconst requestedId = String(\n  prep.requested_invoice_id || ''\n).trim().toLowerCase();\n\nconst filteredRows = requestedId\n  ? rows.filter(r => {\n      const id = String(r.invoice_number || r.invoice_id || '')\n        .trim()\n        .toLowerCase();\n\n      return id === requestedId;\n    })\n  : rows;\n\nlet reply;\n\nif (filteredRows.length) {\n  reply = requestedId\n    ? `📋 تفاصيل الفاتورة:\\n${filteredRows.map(r =>\n        `رقم الفاتورة: ${r.invoice_number || r.invoice_id || '-'} | المبلغ: ${r.amount ?? '-'} | الحالة: ${r.approval_status || r.status || '-'}`\n      ).join('\\n')}`\n    : `📋 الفواتير:\\n${filteredRows.map(r =>\n        `رقم الفاتورة: ${r.invoice_number || r.invoice_id || '-'} | المبلغ: ${r.amount ?? '-'} | الحالة: ${r.approval_status || r.status || '-'}`\n      ).join('\\n')}`;\n} else {\n  reply = requestedId\n    ? `⚠️ لم يتم العثور على الفاتورة بالرقم ${prep.requested_invoice_id || prep.invoice_id}.`\n    : '📋 لا توجد فواتير.';\n}\n\nreturn [{\n  json: {\n    ...prep,\n    reply,\n    invoices: filteredRows,\n    result_type: 'invoice_view',\n    audit_action: 'view',\n    audit_status: requestedId && !filteredRows.length ? 'not_found' : 'success'\n  }\n}];"
      },
