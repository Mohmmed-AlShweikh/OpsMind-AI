    {
      "parameters": {
        "jsCode": "\nconst prep = $('Prepare Invoice Request').first().json || {};\nconst request = String(prep.request || '').trim();\nconst requestedId = String(prep.requested_invoice_id || '').trim();\n\nconst amountMatch =\n  request.match(/(?:المبلغ|مبلغها|مبلغ|amount)\\s*(?:إلى|الى|يساوي|بمقدار|=|:)?\\s*(\\d+(?:\\.\\d+)?)/i);\n\nif (!requestedId) {\n  return [{\n    json: {\n      ...prep,\n      not_found: true,\n      reply: '⚠️ لم يتم تحديد رقم الفاتورة المطلوب تعديلها.',\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nif (!amountMatch) {\n  return [{\n    json: {\n      ...prep,\n      not_found: true,\n      reply: '⚠️ لم يتم تحديد المبلغ الجديد.',\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...prep,\n    requested_invoice_id: requestedId,\n    new_amount: Number(amountMatch[1]),\n    not_found: false,\n    audit_action: 'update',\n    audit_status: 'pending'\n  }\n}];"
      },
