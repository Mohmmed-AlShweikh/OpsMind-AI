    {
      "parameters": {
        "jsCode": "\nconst d = $json || {};\n\nlet updated = {};\n\ntry {\n  updated = $('Find Invoice To Update').first().json || {};\n} catch (e) {\n  updated = {};\n}\n\n// 1. منع رسالة النجاح إذا كانت الفاتورة موجودة بالفعل\nif (\n  d.result_type === 'invoice_duplicate' ||\n  d.duplicate === true\n) {\n  const invoiceId =\n    d.invoice_id ||\n    d.requested_invoice_id ||\n    'غير محدد';\n\n  return [{\n    json: {\n      ...d,\n      reply: `⚠️ الفاتورة ${invoiceId} موجودة بالفعل، لم تتم إضافتها مرة أخرى.`,\n      result_type: 'invoice_duplicate',\n      audit_action: 'add',\n      audit_status: 'failed'\n    }\n  }];\n}\n\n// 2. معالجة أخطاء إضافة الفاتورة\nif (d.add_error === true || d.result_type === 'invoice_add_error') {\n  return [{\n    json: {\n      ...d,\n      reply: d.reply ||\n        '⚠️ تعذرت إضافة الفاتورة. تأكد من رقم الفاتورة والمورد والمبلغ.',\n      result_type: 'invoice_add_error',\n      audit_action: 'add',\n      audit_status: 'failed'\n    }\n  }];\n}\n\n// 3. معالجة الفاتورة غير الموجودة عند التعديل\nif (d.not_found === true || updated.not_found === true) {\n  return [{\n    json: {\n      ...d,\n      reply: d.reply ||\n        updated.reply ||\n        '⚠️ لم يتم العثور على الفاتورة.',\n      result_type: 'invoice_not_found'\n    }\n  }];\n}\n\n// 4. معالجة تعديل الفاتورة\nconst action = String(\n  d.request_action ||\n  d.action ||\n  updated.request_action ||\n  updated.action ||\n  ''\n).toLowerCase();\n\nif (\n  action === 'update' ||\n  updated.request_action === 'update' ||\n  updated.new_amount !== undefined\n) {\n  const invoiceId =\n    updated.invoice_number ||\n    updated.invoice_id ||\n    d.invoice_number ||\n    d.invoice_id ||\n    updated.requested_invoice_id ||\n    d.requested_invoice_id ||\n    'غير محدد';\n\n  const amount =\n    updated.new_amount ??\n    d.new_amount ??\n    d.amount ??\n    'غير محدد';\n\n  return [{\n    json: {\n      ...d,\n      reply: `✅ تم تعديل الفاتورة ${invoiceId} بنجاح.\\n💰 المبلغ الجديد: ${amount}`,\n      result_type: 'invoice_update',\n      audit_action: 'update',\n      audit_status: 'success'\n    }\n  }];\n}\n\n// 5. معالجة نجاح إضافة الفاتورة\nif (\n  action === 'add' ||\n  d.result_type === 'invoice_add'\n) {\n  const invoiceId =\n    d.invoice_id ||\n    d.requested_invoice_id ||\n    'غير محدد';\n\n  const amount =\n    d.amount ??\n    d.new_amount ??\n    'غير محدد';\n\n  return [{\n    json: {\n      ...d,\n      reply: `✅ تمت إضافة الفاتورة ${invoiceId} بنجاح.\\n💰 المبلغ: ${amount}`,\n      result_type: 'invoice_add',\n      audit_action: 'add',\n      audit_status: 'success'\n    }\n  }];\n}\n\n// 6. عرض الفواتير\nconst rows = Array.isArray(d.invoices)\n  ? d.invoices\n  : [d];\n\nconst validRows = rows.filter(\n  r => r.invoice_id || r.invoice_number\n);\n\nreturn [{\n  json: {\n    ...d,\n    reply: validRows.length\n      ? `📋 الفواتير:\\n${validRows.map(r =>\n          `رقم الفاتورة: ${r.invoice_number || r.invoice_id} | المبلغ: ${r.amount ?? '-'} | الحالة: ${r.approval_status || r.status || '-'}`\n        ).join('\\n')}`\n      : '📋 لا توجد فواتير.',\n    result_type: 'invoice_view'\n  }\n}];"
      },
