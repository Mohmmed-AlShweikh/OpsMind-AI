    {
      "parameters": {
        "jsCode": "\nconst prep = $('Prepare Invoice Update').first().json || {};\nconst rows = $('Get Invoices').all().map(item => item.json || {});\nconst requestedId = String(prep.requested_invoice_id || '').trim().toLowerCase();\n\nconst found = rows.find(row =>\n  String(row.invoice_id || '').trim().toLowerCase() === requestedId ||\n  String(row.invoice_number || '').trim().toLowerCase() === requestedId\n);\n\nif (!found) {\n  return [{\n    json: {\n      ...prep,\n      not_found: true,\n      reply: `⚠️ الفاتورة ${prep.requested_invoice_id} غير موجودة. لم يتم إجراء أي تعديل.`,\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...found,\n    ...prep,\n    invoice_id: found.invoice_id,\n    supplier_id: found.supplier_id,\n    invoice_number: found.invoice_number,\n    amount: found.amount,\n    date: found.date,\n    status: found.status,\n    approval_status: found.approval_status,\n    new_amount: prep.new_amount,\n    not_found: false\n  }\n}];"
      },
