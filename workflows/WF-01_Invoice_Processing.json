    {
      "parameters": {
        "jsCode": "\nconst input = $('When Executed by Another Workflow').first().json || {};\nconst request = String(input.request || '').trim();\n\nconst isCreateRequest =\n  /إضافة\\s+فاتورة|اضف\\s+فاتورة|أضف\\s+فاتورة|انشاء\\s+فاتورة|إنشاء\\s+فاتورة|فاتورة\\s+جديدة/i.test(request);\n\nconst isUpdateRequest =\n  /عدل|عدّل|تعديل|غيّر|غير|اجعل|حدّث|حدث/i.test(request);\n\nconst incomingAction = String(input.action || 'view').toLowerCase();\n\nconst action = isCreateRequest || incomingAction === 'add'\n  ? 'add'\n  : isUpdateRequest || incomingAction === 'update'\n    ? 'update'\n    : incomingAction;\n\n// استخراج رقم الفاتورة، بما في ذلك الصيغة: فاتورة رقم INV004\nconst invoiceMatch =\n  request.match(/(?:invoice[_\\s-]*id|invoice\\s*(?:number|no\\.?)|رقم\\s+الفاتورة|فاتورة\\s+رقم|الفاتورة)\\s*[:=#-]?\\s*([A-Za-z0-9_-]+)/i);\n\n// استخراج رقم المورد، بما في ذلك الصيغة: للمورد S004\nconst supplierMatch =\n  request.match(/(?:supplier[_\\s-]*id|رقم\\s+المورد|للمورد|المورد)\\s*[:=#-]?\\s*([A-Za-z0-9_-]+)/i);\n\n// استخراج المبلغ\nconst amountMatch =\n  request.match(/(?:المبلغ|مبلغها|بمبلغ|مبلغ|amount)\\s*(?:إلى|الى|يساوي|بمقدار|=|:)?\\s*(\\d+(?:\\.\\d+)?)/i);\n\nreturn $input.all().map(item => {\n  const r = {\n    ...item.json,\n    request,\n    request_action: action,\n    requested_invoice_id: invoiceMatch ? invoiceMatch[1] : '',\n    requested_supplier_id: supplierMatch ? supplierMatch[1] : '',\n    chat_id: String(input.chat_id || ''),\n    user_id: String(input.user_id || ''),\n    user_name: String(input.user_name || ''),\n    role: String(input.role || ''),\n    intent: 'invoice'\n  };\n\n  if (amountMatch) {\n    r.new_amount = Number(amountMatch[1]);\n  }\n\n  return { json: r };\n});"
      },
