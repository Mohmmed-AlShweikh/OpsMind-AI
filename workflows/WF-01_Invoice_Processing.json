      "parameters": {
        "jsCode": "const d=$json||{}; const valid=!!(d.invoice_id&&d.supplier_id&&d.amount); const amount=Number(d.amount||0); return [{json:{...d,validation_status:valid?'Valid':'Missing required data',approval_status:valid?(amount>1000?'Pending Manager Approval':'Auto Approved'):'Invalid',needs_manager_approval:valid&&amount>1000}}];"
      },
