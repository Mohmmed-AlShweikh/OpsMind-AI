    {
      "parameters": {
        "jsCode": "\nconst prep = $('Prepare Invoice Request').first().json || {};\nconst rows = $('Get Invoices').all().map(item => item.json || {});\n\nconst invoiceId = String(\n  prep.requested_invoice_id || ''\n).trim().toLowerCase();\n\nconst supplierId = String(\n  prep.requested_supplier_id || ''\n).trim();\n\nconst amount = Number(prep.new_amount);\n\nif (!invoiceId || !supplierId || !Number.isFinite(amount) || amount <= 0) {\n  return [{\n    json: {\n      ...prep,\n      invoice_id: invoiceId,\n      supplier_id: supplierId,\n      amount,\n      duplicate: false,\n      add_error: true,\n      reply: '⚠️ تعذرت إضافة الفاتورة. تأكد من رقم الفاتورة والمورد والمبلغ.'\n    }\n  }];\n}\n\nconst existingInvoices = rows\n  .map(row => String(row.invoice_id || '').trim().toLowerCase())\n  .filter(Boolean);\n\nconst duplicate = existingInvoices.includes(invoiceId);\n\nreturn [{\n  json: {\n    ...prep,\n    invoice_id: String(prep.requested_invoice_id).trim(),\n    supplier_id: supplierId,\n    amount,\n    duplicate,\n    add_error: false,\n    existing_invoice_ids: existingInvoices\n  }\n}];"
      },
