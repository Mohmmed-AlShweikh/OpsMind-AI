        "jsCode": "const input=$('Prepare Customer Action').first().json||{};\nconst rows=$input.all().map(x=>x.json||{});\nconst targetId=String(input.customer_id||'').trim().toLowerCase();\nconst targetName=String(input.name||'').trim().toLowerCase();\nif(!targetId&&!targetName)return [{json:{...input,not_found:true,reply:'⚠️ للحذف أرسل رقم العميل أو اسمه.',result_type:'customer_delete',audit_action:'delete',audit_status:'failed'}}];\nconst found=rows.find(r=>{\n const id=String(r.customer_id??'').trim().toLowerCase();\n const name=String(r.name??'').trim().toLowerCase();\n return (targetId&&id===targetId)||(targetName&&name===targetName);\n});\nif(!found)return [{json:{...input,not_found:true,reply:'⚠️ لم يتم العثور على العميل المطلوب للحذف.',result_type:'customer_delete',audit_action:'delete',audit_status:'failed'}}];\nreturn [{json:{...input,...found,customer_id:String(found.customer_id||input.customer_id||'').trim().toUpperCase(),customer_name:String(found.name||input.name||'').trim(),row_number:found.row_number,not_found:false}}];"
