      "parameters": {
        "jsCode": "\nconst input = $('Prepare Customer Action').first()?.json || {};\nconst rows = $input.all().map(item => item.json || {});\n\nconst normalizeId = value =>\n  String(value ?? '').trim().toLowerCase();\n\nconst targetId = normalizeId(input.customer_id);\n\nif (!targetId) {\n  return [{\n    json: {\n      ...input,\n      not_found: true,\n      reply: '⚠️ أرسل رقم العميل الذي تريد تعديله.',\n      result_type: 'customer_update',\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nconst found = rows.find(row =>\n  normalizeId(row.customer_id) === targetId\n);\n\nif (!found) {\n  return [{\n    json: {\n      ...input,\n      not_found: true,\n      reply: `⚠️ العميل ${input.customer_id} غير موجود، ولم يتم إجراء أي تعديل.`,\n      result_type: 'customer_update',\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nconst fields = ['name', 'phone', 'email', 'status', 'notes'];\n\nconst changed = fields.filter(key =>\n  input[key] !== undefined &&\n  input[key] !== null &&\n  String(input[key]).trim() !== ''\n);\n\nif (!changed.length) {\n  return [{\n    json: {\n      ...input,\n      ...found,\n      customer_id: found.customer_id,\n      not_found: false,\n      missing_update_fields: true,\n      reply: '⚠️ العميل موجود، لكن لم تحدد البيانات التي تريد تعديلها.',\n      result_type: 'customer_update',\n      audit_action: 'update',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nconst updateData = {\n  ...input,\n  ...found,\n  customer_id: found.customer_id,\n  not_found: false,\n  missing_update_fields: false\n};\n\n// Keep only fields explicitly supplied for the update.\nfor (const key of fields) {\n  if (\n    input[key] !== undefined &&\n    input[key] !== null &&\n    String(input[key]).trim() !== ''\n  ) {\n    updateData[key] = input[key];\n  }\n}\n\nreturn [{ json: updateData }];"
      },
