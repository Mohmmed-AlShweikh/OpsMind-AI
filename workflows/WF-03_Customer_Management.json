    {
      "parameters": {
        "jsCode": "\nconst d = $('Prepare Customer Add').first()?.json || {};\nconst rows = $input.all().map(item => item.json || {});\n\nconst normalizeEmail = v => String(v ?? '').trim().toLowerCase();\nconst normalizePhone = v =>\n  String(v ?? '').replace(/\\D/g, '').replace(/^0+/, '');\n\nconst inputEmail = normalizeEmail(d.email);\nconst inputPhone = normalizePhone(d.phone);\n\nconst existing = rows.find(r =>\n  (inputEmail && normalizeEmail(r.email) === inputEmail) ||\n  (inputPhone && normalizePhone(r.phone) === inputPhone)\n);\n\nif (existing) {\n  const emailExists = inputEmail !== '' &&\n    normalizeEmail(existing.email) === inputEmail;\n\n  const phoneExists = inputPhone !== '' &&\n    normalizePhone(existing.phone) === inputPhone;\n\n  const reasons = [];\n  if (emailExists) reasons.push('البريد الإلكتروني');\n  if (phoneExists) reasons.push('رقم الهاتف');\n\n  return [{\n    json: {\n      ...d,\n      duplicate: true,\n      reply: `⚠️ لم تتم إضافة العميل لأن ${reasons.join(' و ')} مستخدم مسبقًا.\\nالعميل الموجود: ${existing.customer_id || '-'} - ${existing.name || '-'}.`,\n      result_type: 'customer_add',\n      audit_action: 'add',\n      audit_status: 'failed'\n    }\n  }];\n}\n\nconst ids = rows.map(r =>\n  Number(String(r.customer_id ?? '').match(/^C(\\d+)$/i)?.[1] || 0)\n);\n\nreturn [{\n  json: {\n    ...d,\n    duplicate: false,\n    customer_id: `C${String(Math.max(0, ...ids) + 1).padStart(3, '0')}`,\n    name: String(d.name ?? '').trim(),\n    phone: String(d.phone ?? '').trim(),\n    email: inputEmail,\n    status: String(d.status || 'Active').trim(),\n    notes: String(d.notes || '').trim()\n  }\n}];"
      },
