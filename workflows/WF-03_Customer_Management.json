      "parameters": {
        "jsCode": "\nconst input = $json || {};\n\nconst normalizeId = (value) =>\n  String(value ?? '').trim().toUpperCase();\n\nconst clean = (value) => {\n  if (value === undefined || value === null) return undefined;\n  const result = String(value).trim();\n  return result || undefined;\n};\n\n// Read the original request, including structured input if provided.\nlet request = input.request ?? '';\nlet parsedRequest = {};\n\nif (typeof request === 'object' && request !== null) {\n  parsedRequest = request;\n  request = '';\n} else {\n  request = String(request);\n  try {\n    const parsed = JSON.parse(request);\n    if (parsed && typeof parsed === 'object') {\n      parsedRequest = parsed;\n    }\n  } catch {}\n}\n\nlet aiData = input.data ?? {};\nif (typeof aiData === 'string') {\n  try {\n    aiData = JSON.parse(aiData);\n  } catch {\n    aiData = {};\n  }\n}\nif (!aiData || typeof aiData !== 'object' || Array.isArray(aiData)) {\n  aiData = {};\n}\n\nconst source = {\n  ...input,\n  ...parsedRequest,\n  ...aiData,\n};\n\nconst text = String(request).trim();\n\nconst get = (...keys) => {\n  for (const key of keys) {\n    const value = source[key];\n    if (value !== undefined && value !== null &&\n        String(value).trim() !== '') {\n      return value;\n    }\n  }\n  return undefined;\n};\n\n// Extract values from labels such as:\n// الاسم: أحمد\n// Customer Name: Ahmad\n// رقم التلفون: 0590000000\nfunction labeledValue(labels) {\n  const label = labels.join('|');\n  const re = new RegExp(\n    '(?:^|\\\\n|[,;|])\\\\s*(?:' + label +\n    ')\\\\s*[:=：-]\\\\s*([^\\\\n,;|]+)',\n    'i'\n  );\n  return text.match(re)?.[1]?.trim();\n}\n\nlet action = String(source.action || '').trim().toLowerCase();\n\nif (!['view', 'add', 'update', 'delete'].includes(action)) {\n  if (/\\b(add|create)\\b|إضافة|اضافة|أضف|اضف|ضيف|سجّل|سجل|أنشئ|انشئ/i.test(text)) {\n    action = 'add';\n  } else if (/\\b(update|edit|change)\\b|تعديل|عدّل|عدل|غيّر|غير|حدّث|حدث|زبط|ظبط/i.test(text)) {\n    action = 'update';\n  } else if (/\\b(delete|remove)\\b|احذف|حذف|امسح|مسح|شيل/i.test(text)) {\n    action = 'delete';\n  } else {\n    action = 'view';\n  }\n}\n\nlet customer_id = get('customer_id', 'customerId', 'id');\nlet name = get('name', 'customer_name', 'customerName');\nlet email = get('email', 'e_mail');\nlet phone = get('phone', 'phone_number', 'phoneNumber', 'mobile');\nlet status = get('status');\nlet notes = get('notes', 'note');\n\n// Extract common Arabic and English field labels.\nname = name || labeledValue([\n  'name', 'customer\\\\s*name', 'الاسم',\n  'اسم\\\\s*العميل', 'اسم\\\\s*الزبون', 'اسم\\\\s*الزبون'\n]);\n\nemail = email || labeledValue([\n  'email', 'e-mail', 'البريد\\\\s*الإلكتروني',\n  'البريد\\\\s*الالكتروني', 'الإيميل', 'الايميل',\n  'ايميل', 'إيميل'\n]);\n\nphone = phone || labeledValue([\n  'phone', 'phone\\\\s*number', 'mobile',\n  'رقم\\\\s*الهاتف', 'رقم\\\\s*التلفون',\n  'الهاتف', 'التلفون', 'الجوال', 'رقم\\\\s*الجوال'\n]);\n\nstatus = status || labeledValue([\n  'status', 'الحالة'\n]);\n\nnotes = notes || labeledValue([\n  'notes?', 'ملاحظات', 'التفاصيل\\\\s*الإضافية'\n]);\n\n// Extract email and phone if labels were omitted.\nemail = email || text.match(\n  /[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i\n)?.[0];\n\nif (!phone) {\n  phone = text.match(\n    /(?:\\+?\\d[\\d ()-]{6,}\\d)/\n  )?.[0]?.trim();\n}\n\n// Extract customer IDs without case sensitivity.\nif (!customer_id) {\n  customer_id = text.match(\n    /(?:customer\\s*(?:id|number|no)?|رقم\\s*العميل|العميل\\s*(?:رقم\\s*)?|معرّف\\s*العميل|معرف\\s*العميل)\\s*[:=#-]?\\s*(C\\d+|[A-Z]+\\d+|\\d+)/i\n  )?.[1];\n}\n\nif (!customer_id) {\n  customer_id = text.match(/\\b(C\\d+)\\b/i)?.[1];\n}\n\n// Support comma-separated add requests as well.\nif (action === 'add') {\n  const rest = text.replace(\n    /^\\s*(?:add|create|أضف|اضف|ضيف|إضافة|اضافة|أنشئ|انشئ)\\s*,?\\s*(?:customer|عميل|زبون)?\\s*,?\\s*/i,\n    ''\n  ).trim();\n\n  const values = rest.split(',').map(v => v.trim()).filter(Boolean);\n\n  // Use positional parsing only when no labeled fields were found.\n  if (!name && !email && !phone && values.length >= 3) {\n    name = values[0];\n    phone = values[1];\n    email = values[2];\n    status = status || values[3];\n    notes = notes || values.slice(4).join(', ');\n  }\n\n  // Customer IDs are generated by the workflow during creation.\n  customer_id = undefined;\n}\n\n// Support natural update requests.\nif (action === 'update') {\n  const updateId = text.match(\n    /(?:customer\\s*(?:id|number)?|العميل\\s*(?:رقم\\s*)?|رقم\\s*العميل)\\s*[:=#-]?\\s*(C\\d+|[A-Z]+\\d+|\\d+)/i\n  )?.[1];\n\n  customer_id = customer_id || updateId;\n\n  name = name || text.match(\n    /(?:اسمه|اسمها|الاسم|اسم\\s*العميل|name)\\s*[:=]?\\s*([^,\\n;|]+)/i\n  )?.[1]?.trim();\n\n  phone = phone || text.match(\n    /(?:هاتفه|هاتفها|رقم\\s*الهاتف|رقم\\s*التلفون|جواله|جوالها|phone)\\s*[:=]?\\s*(\\+?\\d[\\d ()-]{6,}\\d)/i\n  )?.[1]?.trim();\n\n  email = email || text.match(\n    /(?:إيميله|ايميله|بريده|البريد\\s*الإلكتروني|الإيميل|الايميل|email)\\s*[:=]?\\s*([A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,})/i\n  )?.[1]?.trim();\n}\n\nreturn [{\n  json: {\n    ...input,\n    action,\n    customer_id: customer_id ? normalizeId(customer_id) : undefined,\n    name: clean(name),\n    email: clean(email),\n    phone: clean(phone),\n    status: clean(status),\n    notes: clean(notes),\n  }\n}];"
