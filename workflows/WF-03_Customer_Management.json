        "jsCode": "const x = $('Find Customer To Update').first()?.json || {};\nconst f = x.found_customer || {};\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nreturn [{json:{\n  ...x,\n  customer_id: has(x.customer_id) ? String(x.customer_id).trim() : String(f.customer_id || '').trim(),\n  name: has(x.name) ? String(x.name).trim() : String(f.name || '').trim(),\n  phone: has(x.phone) ? String(x.phone).trim() : String(f.phone || '').trim(),\n  email: has(x.email) ? String(x.email).trim() : String(f.email || '').trim(),\n  status: has(x.status) ? String(x.status).trim() : String(f.status || 'Active').trim(),\n  notes: has(x.notes) ? String(x.notes).trim() : String(f.notes || '').trim()\n}}];"
